    { "id": "cf3", "time_ms": 600, "property": "style.fill", "value": { "type": "Color", "value": "#22c55e" }, "easing": "Linear" },
    { "id": "cf4", "time_ms": 900, "property": "style.fill", "value": { "type": "Color", "value": "#eab308" }, "easing": "Linear" },
    { "id": "cf5", "time_ms": 1200, "property": "style.fill", "value": { "type": "Color", "value": "#3b82f6" }, "easing": "Linear" }
  ]
}
