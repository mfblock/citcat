  "duration_ms": 1200,
  "applies_to": ["Text", "Rect", "Ellipse", "Button"],
  "keyframes": [
    { "id": "cf1", "time_ms": 0, "property": "style.fill", "value": { "type": "Color", "value": "#3b82f6" }, "easing": "Linear" },
